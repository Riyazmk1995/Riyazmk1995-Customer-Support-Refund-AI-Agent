# Backend Configuration
API_URL=http://localhost:8000
BACKEND_PORT=8000

# Frontend Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# LLM Configuration (Optional)
USE_LLM=false
OPENAI_API_KEY= #give your OpenAI API key
LLM_MODEL=gpt-3.5-turbo

# Available LLM Models:
# - gpt-3.5-turbo (default, fastest, cheapest)
# - gpt-4o (most capable, more expensive)
# - gpt-4-turbo (better than 3.5, less expensive than 4)
# - gpt-4 (full GPT-4, most expensive)

# Mode Switching:
# - Use Streamlit sidebar: Select "rule-based" or "llm" mode
# - Pass mode parameter in API: {"mode": "llm"} or {"mode": "rule-based"}
# - Both modes always available (LLM requires OPENAI_API_KEY)

# Environment
ENVIRONMENT=development
